{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamekit.local/schemas/agent_prefab_ops.schema.json",
  "title": "GameKit Unity Agent Prefab Ops",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetKind", "targetPath", "operations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targetKind": {
      "enum": ["prefab", "scene"]
    },
    "targetPath": {
      "type": "string",
      "pattern": "^Assets/.+\\.(prefab|unity)$"
    },
    "resultPath": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "objectPath"],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "op": {
          "enum": ["SetActive", "RenameGameObject", "SetSerializedField", "AssignReference"]
        },
        "objectPath": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "newName": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "type": "string",
          "minLength": 1
        },
        "propertyPath": {
          "type": "string",
          "minLength": 1
        },
        "valueType": {
          "enum": ["bool", "int", "float", "string", "enum", "vector2", "vector3", "color"]
        },
        "value": {
          "type": "string"
        },
        "referenceKind": {
          "enum": ["gameObject", "transform", "component", "asset"]
        },
        "referenceObjectPath": {
          "type": "string",
          "minLength": 1
        },
        "referenceComponentType": {
          "type": "string",
          "minLength": 1
        },
        "assetPath": {
          "type": "string",
          "pattern": "^Assets/.+"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "SetActive"
              }
            }
          },
          "then": {
            "required": ["active"]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "RenameGameObject"
              }
            }
          },
          "then": {
            "required": ["newName"]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "SetSerializedField"
              }
            }
          },
          "then": {
            "required": ["componentType", "propertyPath", "value"]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "AssignReference"
              }
            }
          },
          "then": {
            "required": ["componentType", "propertyPath", "referenceKind"]
          }
        },
        {
          "if": {
            "required": ["referenceKind"],
            "properties": {
              "referenceKind": {
                "enum": ["gameObject", "transform", "component"]
              }
            }
          },
          "then": {
            "required": ["referenceObjectPath"]
          }
        },
        {
          "if": {
            "required": ["referenceKind"],
            "properties": {
              "referenceKind": {
                "const": "component"
              }
            }
          },
          "then": {
            "required": ["referenceComponentType"]
          }
        },
        {
          "if": {
            "required": ["referenceKind"],
            "properties": {
              "referenceKind": {
                "const": "asset"
              }
            }
          },
          "then": {
            "required": ["assetPath"]
          }
        }
      ]
    }
  }
}
